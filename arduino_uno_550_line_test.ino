// Arduino Uno compile and upload test
// Uses only built-in Arduino functions; no external libraries.
// The built-in LED on pin 13 blinks once per second.

const byte LED_PIN = LED_BUILTIN;
unsigned long lastToggle = 0;
bool ledState = false;

void setup() {
  pinMode(LED_PIN, OUTPUT);
  Serial.begin(9600);
  Serial.println(F("Arduino Uno test started"));
}

void loop() {
  unsigned long now = millis();
  if (now - lastToggle >= 500UL) {
    lastToggle = now;
    ledState = !ledState;
    digitalWrite(LED_PIN, ledState ? HIGH : LOW);
    Serial.println(ledState ? F("LED ON") : F("LED OFF"));
  }
}

