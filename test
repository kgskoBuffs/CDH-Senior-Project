// Arduino Uno functional test: LED, Serial, math, arrays, state machine.
// Open Serial Monitor at 9600 baud. Send h for command help.
// No external libraries or wiring required.
#include <Arduino.h>
const byte LED_PIN = LED_BUILTIN;
unsigned long lastBlink = 0;
unsigned long lastReport = 0;
unsigned long blinkInterval = 500;
bool ledOn = false;
bool blinking = true;
bool reporting = true;
uint32_t iterations = 0;
uint16_t samples[32] = {0};
byte samplePos = 0;
uint32_t sampleSum = 0;
uint16_t minSample = 1023;
uint16_t maxSample = 0;
uint32_t rngState = 123456789UL;
byte mode = 0;
uint16_t checksum = 0;
uint16_t testFailures = 0;
uint32_t testPasses = 0;

uint16_t nextRandom() {
  rngState ^= rngState << 13;
  rngState ^= rngState >> 17;
  rngState ^= rngState << 5;
  return (uint16_t)(rngState & 1023UL);
}
void storeSample(uint16_t v) {
  sampleSum -= samples[samplePos];
  samples[samplePos] = v;
  sampleSum += v;
  samplePos = (samplePos + 1) % 32;
  if (v < minSample) minSample = v;
  if (v > maxSample) maxSample = v;
}
uint16_t rollingAverage() { return (uint16_t)(sampleSum / 32UL); }
void printHelp() {
  Serial.println(F("Commands: h help, b blink, r reports,"));
  Serial.println(F("1 slow, 2 medium, 3 fast,"));
  Serial.println(F("t self-test, s status, c clear stats,"));
  Serial.println(F("m change math mode, l LED toggle"));
}
void printStatus() {
  Serial.print(F("Uptime ms: ")); Serial.println(millis());
  Serial.print(F("Loop count: ")); Serial.println(iterations);
  Serial.print(F("Blink interval: ")); Serial.println(blinkInterval);
  Serial.print(F("LED: ")); Serial.println(ledOn ? F("ON") : F("OFF"));
  Serial.print(F("Rolling avg: ")); Serial.println(rollingAverage());
  Serial.print(F("Min/Max: ")); Serial.print(minSample);
  Serial.print('/'); Serial.println(maxSample);
  Serial.print(F("Checksum: ")); Serial.println(checksum);
  Serial.print(F("Mode: ")); Serial.println(mode);
  Serial.print(F("Tests passed: ")); Serial.println(testPasses);
  Serial.print(F("Tests failed: ")); Serial.println(testFailures);
}
void clearStats() {
  for (byte i = 0; i < 32; ++i) samples[i] = 0;
  sampleSum = 0;
  samplePos = 0;
  minSample = 1023;
  maxSample = 0;
  checksum = 0;
  iterations = 0;
}
void check(bool ok) {
  if (ok) ++testPasses;
  else ++testFailures;
}
void runSelfTest() {
  Serial.println(F("Running functional self-tests..."));
  check(rollingAverage() <= 1023);
  check(samplePos < 32);
  check(blinkInterval >= 50);
  check(minSample <= 1023);
  check(maxSample <= 1023);
  check((uint16_t)(200U + 300U) == 500U);
  check((uint16_t)(12U * 12U) == 144U);
  check((uint16_t)(1024U / 4U) == 256U);
  check((uint16_t)(0x55U ^ 0xAAU) == 0xFFU);
  check((uint16_t)(1U << 7) == 128U);
  Serial.print(F("Total pass: ")); Serial.println(testPasses);
  Serial.print(F("Total fail: ")); Serial.println(testFailures);
}
void handleCommand(char c) {
  switch (c) {
    case 'h': printHelp(); break;
    case 'b': blinking = !blinking; break;
    case 'r': reporting = !reporting; break;
    case '1': blinkInterval = 1000; break;
    case '2': blinkInterval = 500; break;
    case '3': blinkInterval = 100; break;
    case 't': runSelfTest(); break;
    case 's': printStatus(); break;
    case 'c': clearStats(); break;
    case 'm': mode = (mode + 1) % 4; break;
    case 'l':
      blinking = false;
      ledOn = !ledOn;
      digitalWrite(LED_PIN, ledOn ? HIGH : LOW);
      break;
    case '\n': case '\r': break;
    default: Serial.println(F("Unknown command. Send h.")); break;
  }
}
